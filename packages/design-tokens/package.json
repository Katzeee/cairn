{
  "name": "@cairn/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./themes/forest.css": "./dist/themes/forest.css",
    "./themes/slate.css": "./dist/themes/slate.css"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "prebuild": "npm run clean",
    "build": "node scripts/generate.mjs && tsc",
    "test": "node --test scripts/generate.test.mjs",
    "typecheck": "node scripts/generate.mjs --source-only && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@radix-ui/colors": "^3.0.0",
    "bezier-easing": "^3.1.0",
    "colorjs.io": "^0.7.1",
    "typescript": "^6.0.3"
  }
}
